<%- include('partials/header') %>

<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-inner">
    <div class="hero-copy reveal">
      <span class="hero-eyebrow">🇩🇿 <%= t('hero_eyebrow') %></span>
      <h1><%= t('hero_title') %></h1>
      <p><%= t('hero_subtitle') %></p>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href="/products"><%= t('hero_cta_browse') %></a>
        <a class="btn btn-outline btn-lg" href="/become-seller"><%= t('hero_cta_sell') %></a>
      </div>
    </div>
    <div class="hero-art reveal" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="280" height="280">
        <rect x="90" y="20" width="140" height="280" rx="26" fill="var(--surface)" stroke="var(--ink)" stroke-width="3"/>
        <rect x="104" y="46" width="112" height="200" rx="6" fill="var(--accent-soft)"/>
        <circle cx="160" cy="270" r="10" fill="none" stroke="var(--ink)" stroke-width="3"/>
        <rect x="40" y="90" width="36" height="70" rx="10" fill="var(--accent)"/>
        <rect x="244" y="150" width="36" height="70" rx="10" fill="var(--accent-2)"/>
      </svg>
    </div>
  </div>
</section>

<section class="trust-strip">
  <div class="trust-inner">
    <span>✓ <%= t('trust_1') %></span>
    <span>✓ <%= t('trust_2') %></span>
    <span>✓ <%= t('trust_3') %></span>
  </div>
</section>

<% if (brands.length) { %>
<section class="brand-strip">
  <div class="section-inner">
    <% brands.forEach(function(b){ %><a class="brand-chip" href="/products?brand=<%= b %>"><%= b %></a><% }) %>
  </div>
</section>
<% } %>

<% if (deals.length) { %>
<section class="section">
  <div class="section-inner">
    <div class="section-head reveal">
      <h2><%= t('deals_title') %></h2>
      <a href="/products" class="section-link"><%= t('see_all') %> →</a>
    </div>
    <div class="product-grid">
      <% deals.forEach(function(p){ %><%- include('partials/product-card', { p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (newest.length) { %>
<section class="section section-alt">
  <div class="section-inner">
    <div class="section-head reveal">
      <h2><%= t('new_arrivals_title') %></h2>
      <a href="/products?sort=newest" class="section-link"><%= t('see_all') %> →</a>
    </div>
    <div class="product-grid">
      <% newest.forEach(function(p){ %><%- include('partials/product-card', { p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="cta-band">
  <div class="section-inner cta-inner reveal">
    <div>
      <h2><%= t('cta_band_title') %></h2>
      <p><%= t('cta_band_sub') %></p>
    </div>
    <a class="btn btn-primary" href="/become-seller"><%= t('cta_band_button') %> →</a>
  </div>
</section>

<%- include('partials/footer') %>
