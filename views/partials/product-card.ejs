<div class="product-card reveal">
  <a href="/products/<%= p.id %>" class="product-card-link">
    <div class="product-thumb">
      <% if (p.discount_pct > 0) { %><span class="badge-discount">-<%= p.discount_pct %>%</span><% } %>
      <img src="<%= p.image %>" alt="<%= p.brand %> <%= p.model %>" loading="lazy" />
    </div>
    <div class="product-info">
      <span class="product-brand"><%= p.brand %></span>
      <h3 class="product-name"><%= p.model %></h3>
      <div class="product-price-row">
        <span class="product-price"><%= p.final_price_fmt %> DA</span>
        <% if (p.discount_pct > 0) { %><span class="product-price-old"><%= p.price_fmt %> DA</span><% } %>
      </div>
      <span class="product-condition condition-<%= p.condition %>"><%= t('condition_' + p.condition) %></span>
    </div>
  </a>
  <% if (typeof user !== 'undefined' && user) { %>
    <form action="/favorites/<%= p.id %>/toggle" method="post" class="favorite-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="favorite-btn <%= p.is_favorited ? 'active' : '' %>" title="<%= p.is_favorited ? 'Remove from saved' : 'Save this listing' %>" aria-label="Save">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="<%= p.is_favorited ? 'currentColor' : 'none' %>"><path d="M12 20.5s-7.5-4.6-10-9.3C0.3 7.8 2 4 5.6 4c2.1 0 3.6 1.2 4.4 2.4.8-1.2 2.3-2.4 4.4-2.4 3.6 0 5.3 3.8 3.6 7.2-2.5 4.7-10 9.3-10 9.3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      </button>
    </form>
  <% } %>
</div>
